digraph flujo {
  graph [rankdir=TB, bgcolor="#f4f7fb", fontname="DejaVu Sans", label="EIRA · Flujo real y controles pendientes", labelloc=t, fontsize=24, pad="0.3", nodesep="0.35"];
  node [shape=box, style="rounded,filled", fillcolor=white, fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#34465c"];
  subgraph cluster_lab { label="Laboratorio"; color="#3998ad"; carga [label="Subir PDF y datos"]; bandeja [label="Depositar PDF + JSON"]; devuelto [label="devuelto\nCorregir y cargar de nuevo"]; }
  subgraph cluster_sistema { label="Sistema · servicios internos (sin rol de usuario)"; color="#7c88a0"; json [shape=diamond,label="¿JSON y folio\nválidos?"]; validacion [shape=diamond,label="¿Firma PDF\ny tamaño?"]; rechazo [label="Rechazo de importación\nArchivar y auditar"]; cargado [label="cargado"]; identidad [shape=diamond,label="¿Nombre + fecha\n+ folio coinciden?"]; bloqueo [label="Bloquear asociación\ny auditar"]; acceso [shape=diamond,label="¿Enlace vigente, sesión\nverificada e integridad?"]; denegado [label="404 / 409"]; }
  subgraph cluster_eira { label="EIRA · captura y revisión comparten rol"; color="#5d9b6a"; asociado [label="asociado"]; revision [shape=diamond,label="¿Legible y\nuna paciente?\nRevisión humana"]; revisado [label="revisado"]; canal [shape=diamond,label="¿Prefiere digital\ny tiene contacto?"]; notificado [label="notificado\nAviso automático correo/SMS"]; asistida [label="entregado_asistido\nReceptor e identidad\nRevocar enlaces"]; reintento [label="Falla simulada → reintentar otro canal\nRevocar enlace anterior\nDos fallas → requerir asistencia"]; }
  subgraph cluster_medico { label="Médico · sin asignación individual"; color="#ba8a43"; decision [shape=diamond,label="¿Autoriza?\nDistinto del revisor"]; autorizado [label="autorizado\nDecidir aviso o asistencia"]; }
  subgraph cluster_paciente { label="Paciente · SIN cuenta"; color="#8e70bc"; consulta [label="Abrir enlace único del aviso\nVence en 72 horas"]; fecha [shape=diamond,label="¿Fecha correcta?"]; codigo [label="Recibir código aparte\nOtro canal si existe"]; verificar [shape=diamond,label="¿Código correcto?\nVence en 10 minutos"]; error [label="Incorrecto: contar y auditar\nTres errores → bloquear enlace\ny requerir asistencia"]; sesion [label="Sesión verificada de 30 minutos\nAcuse de recibo"]; consultado [label="consultado\nVer o descargar PDF"]; }
  subgraph cluster_pendiente { label="PENDIENTE · no implementado"; color="#c44e52"; pendientes [label="Tutor legal · Asignación médica\nVersiones y descarga de un uso\nLímites a fecha malformada y reenvío de código",fillcolor="#ffe9e9"]; respaldo [label="Proveedor real de correo/SMS\nRespaldo solo simulado",fillcolor="#ffe9e9"]; }
  carga -> validacion;
  bandeja -> json;
  json -> validacion [label="Sí"];
  json -> rechazo [label="No"];
  validacion -> rechazo [label="No"];
  validacion -> cargado [label="Sí"];
  cargado -> identidad;
  identidad -> bloqueo [label="No / homónimo"];
  bloqueo -> identidad [label="Verificar"];
  bloqueo -> devuelto [label="Con motivo"];
  identidad -> asociado [label="Sí"];
  asociado -> revision;
  revision -> devuelto [label="No"];
  revision -> revisado [label="Sí"];
  revisado -> decision;
  decision -> devuelto [label="Devolver con motivo"];
  decision -> autorizado [label="Autorizar"];
  devuelto -> carga [label="Nueva carga independiente",constraint=false];
  autorizado -> canal;
  canal -> notificado [label="Sí: al autorizar"];
  canal -> asistida [label="No: gestionar asistencia"];
  notificado -> asistida [label="Alternativa manual"];
  notificado -> reintento [label="Simular fallo"];
  reintento -> notificado [label="Nuevo aviso",constraint=false];
  reintento -> asistida [label="Tras dos fallas"];
  notificado -> consulta;
  consulta -> denegado [label="Caducado/bloqueado"];
  consulta -> fecha [label="Vigente"];
  fecha -> codigo [label="Sí"];
  fecha -> error [label="No"];
  codigo -> verificar;
  verificar -> error [label="Incorrecto"];
  verificar -> fecha [label="Caducado",constraint=false];
  verificar -> sesion [label="Sí"];
  error -> fecha [label="Menos de tres",constraint=false];
  error -> asistida [label="Bloqueado",constraint=false];
  sesion -> acceso;
  acceso -> denegado [label="No"];
  acceso -> consultado [label="Sí: desde notificado"];
  autorizado -> pendientes [style=dashed,color="#c44e52"];
  notificado -> respaldo [style=dashed,color="#c44e52"];
}
